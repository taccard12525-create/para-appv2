# === Публичный адрес сайта ===
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# === Режим разработки (имитация оплаты, если нет ключей ЮKassa) ===
MOCK_MODE=true

# === ЮKassa ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === GigaChat (Сбер) ===
# Получить на https://developers.sber.ru → GigaChat API → Authorization Key
# ВАЖНО: если ключ где-то засветился — перевыпустите его.
GIGACHAT_AUTH_KEY=ваш_новый_ключ_здесь

# Модель: GigaChat (бесплатная, лимит 365 млн токенов/год),
# GigaChat-Pro (умнее, но меньший лимит), GigaChat-Max (самая мощная)
GIGACHAT_MODEL=GigaChat

# Область доступа: GIGACHAT_API_PERS — для физлиц (бесплатно),
# GIGACHAT_API_CORP — для юрлиц с оплатой
GIGACHAT_SCOPE=GIGACHAT_API_PERS